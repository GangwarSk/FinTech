{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=FinTech;Username=postgres;Password=grsk@12345;Include Error Detail=true"
  },
  "Database": {
    "AutoMigrateOnStartup": true,
    "EnableSensitiveDataLogging": false
  },
  "Jwt": {
    "Issuer": "FinanceAudit360",
    "Audience": "FinanceAudit360.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },
  "FileStorage": {
    "RootPath": "App_Data/storage",
    "StatementsFolder": "statements",
    "ExtractedTextFolder": "extracted",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [ ".pdf" ]
  },
  "Ocr": {
    "Enabled": true,
    "TessDataPath": "tessdata",
    "Language": "eng",
    "RenderScale": 3,
    "MinWordsPerPage": 5,
    "MaxDegreeOfParallelism": 4,
    "CacheMinutes": 30
  },
  "Security": {
    "AllowedCorsOrigins": [ "http://localhost:5173", "http://localhost:4173" ],
    "GlobalRateLimitPerMinute": 240,
    "AuthRateLimitPerMinute": 10,
    "UploadRateLimitPerMinute": 20,
    "SeedAdminPassword": "",
    "EnableRequestAuditLogging": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Quartz": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/financeaudit360-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
